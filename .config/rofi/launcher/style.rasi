/*****----- Global Properties -----*****/
@import                     "rofi-colors.rasi"

configuration {
	modi:                   "drun";
    show-icons:             true;
	drun-display-format:    "{name}";    
    disable-history:        true;
    sort:                   true;
    sorting-method:         "normal";
}

/*****----- Main Window -----*****/
window {
    fullscreen:             false;
    transparency:           "real";
    cursor:                 "default";
    background-color:       black / 64%;
    border:                 0px;
    location:               center;
    anchor:                 center;
    border:                 2px;
    border-radius:          32px;
    width:                  32%;
    border-color:           @selected;
}

/*****----- Main Box -----*****/
mainbox {
    font:                   "JetBrainsMono Nerd Font 12";
    margin:                 16px;
    orientation:            horizontal;
    background-color:       transparent;
    spacing:                16px;
    background-color:       transparent;
    orientation:            vertical;
    children:               [ "inputbar", "listview" ];
}

/*****----- Listview -----*****/
listview {
    columns:                2;
    lines:                  7;
    cycle:                  true;
    dynamic:                true;
    scrollbar:              false;
    layout:                 vertical;
    reverse:                false;
    fixed-height:           true;
    fixed-columns:          true;
    spacing:                8px;
    background-color:       transparent;
}

/*****----- Inputbar -----*****/
inputbar {
    border-radius:          16px;
    background-color:       white / 16%;
    text-color:             @foreground;
    spacing:                0px;
    margin:                 0px;
    padding:                16px;
    children:               [ "entry" ];
}
entry {
    cursor:                 text;
    expand:                 true;
    placeholder-color:      inherit;
    placeholder:            "Search";
    background-color:       transparent;
    text-color:             inherit;
}

/*****----- Elements -----*****/
element {
    cursor:                 pointer;
    text-color:             @foreground;
    background-color:       transparent;
    border-radius:          8px 16px 8px 16px;
    padding:                8px;
}
element-icon {
    background-color:       transparent;
    size:                   24px;
    padding:                0px 8px 0px 0px;
}
element-text {
    background-color:       transparent;
    text-color:             inherit;
    cursor:                 inherit;
    vertical-align:         0.5;
    horizontal-align:       0.0;
}
element selected.normal {
    border:                 0px 0px 2px 2px;
    border-color:           @selected;
    text-color:             @selected;
}