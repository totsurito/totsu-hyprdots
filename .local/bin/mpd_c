#!/usr/bin/env python3

import argparse
import sys
from mpd import MPDClient

MPD_HOST = "localhost"
MPD_PORT = 6600

def connect() -> MPDClient:
    client = MPDClient()
    client.timeout = 5
    try: client.connect(MPD_HOST, MPD_PORT)
    except Exception as e:
        print(f"Error: Couldn't connect to MPD. {e}")
        sys.exit(1)
    return client

def list_exists(name: str) -> bool:
    client = connect
    client.listplaylists()

